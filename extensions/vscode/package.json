{
  "name": "open-trestle",
  "displayName": "Open Trestle",
  "description": "Review the current branch with Open Trestle and show the findings in the Problems panel.",
  "version": "0.1.0",
  "private": true,
  "publisher": "open-trestle",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "code review",
    "diagnostics",
    "sarif",
    "self-hosted"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:openTrestle.reviewBranch",
    "onCommand:openTrestle.clearFindings",
    "onCommand:openTrestle.setUp",
    "onCommand:openTrestle.checkSetup"
  ],
  "contributes": {
    "commands": [
      {
        "command": "openTrestle.reviewBranch",
        "title": "Review Current Branch",
        "category": "Open Trestle"
      },
      {
        "command": "openTrestle.clearFindings",
        "title": "Clear Findings",
        "category": "Open Trestle"
      },
      {
        "command": "openTrestle.setUp",
        "title": "Set Up Repository",
        "category": "Open Trestle"
      },
      {
        "command": "openTrestle.checkSetup",
        "title": "Check Setup",
        "category": "Open Trestle"
      }
    ],
    "configuration": {
      "title": "Open Trestle",
      "properties": {
        "openTrestle.executable": {
          "type": "string",
          "default": "trestle",
          "description": "The trestle command name on PATH, or its absolute path.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check && node esbuild.mjs",
    "check": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --out dist/open-trestle.raw.vsix && node scripts/normalize-vsix.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,js,mjs,md}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,js,mjs,md}\" \"scripts/*.mjs\"",
    "vscode:prepublish": "npm run build",
    "dist:check": "node scripts/check-dist.mjs"
  },
  "files": [
    "dist/extension.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "icon.png"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/georgejieh/open-trestle"
  },
  "bugs": {
    "url": "https://github.com/georgejieh/open-trestle/issues"
  },
  "homepage": "https://github.com/georgejieh/open-trestle",
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  },
  "icon": "icon.png",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "A review runs git in the repository, may run its tests in a sandbox, and sends the change to models."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "A review needs a local folder."
    }
  }
}

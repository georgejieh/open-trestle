{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-trestle:schema:webhook:response:v1",
  "title": "Open Trestle webhook response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version"
  ],
  "properties": {
    "contract": {
      "const": "open-trestle/webhook-response"
    },
    "schema_version": {
      "const": 1
    },
    "acceptance_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "duplicate": {
      "type": "boolean"
    },
    "ignored": {
      "type": "boolean"
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}

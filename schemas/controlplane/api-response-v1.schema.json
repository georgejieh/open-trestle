{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-trestle:schema:controlplane:api-response:v1",
  "title": "Open Trestle API response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "request_id"
  ],
  "properties": {
    "contract": {
      "const": "open-trestle/api-response"
    },
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run": {
      "$ref": "urn:open-trestle:schema:controlplane:review-run-receipt:v1"
    },
    "lease": {
      "oneOf": [
        {
          "$ref": "urn:open-trestle:schema:controlplane:review-task-lease:v1"
        },
        {
          "$ref": "urn:open-trestle:schema:controlplane:task-notification-lease:v1"
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "diagnostics": {
      "oneOf": [
        {
          "$ref": "urn:open-trestle:schema:diagnostics:set:v1"
        },
        {
          "$ref": "urn:open-trestle:schema:diagnostics:set:v2"
        },
        {
          "$ref": "urn:open-trestle:schema:diagnostics:set:v3"
        },
        {
          "$ref": "urn:open-trestle:schema:diagnostics:set:v4"
        },
        {
          "$ref": "urn:open-trestle:schema:diagnostics:set:v5"
        }
      ]
    },
    "plan": {
      "$ref": "urn:open-trestle:schema:controlplane:review-run-plan:v1"
    }
  },
  "oneOf": [
    {
      "required": [
        "run"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "plan"
            ]
          },
          {
            "required": [
              "lease"
            ]
          },
          {
            "required": [
              "diagnostics"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "plan"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "lease"
            ]
          },
          {
            "required": [
              "diagnostics"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "lease"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "plan"
            ]
          },
          {
            "required": [
              "diagnostics"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "diagnostics"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "plan"
            ]
          },
          {
            "required": [
              "lease"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "run"
            ]
          },
          {
            "required": [
              "plan"
            ]
          },
          {
            "required": [
              "lease"
            ]
          },
          {
            "required": [
              "diagnostics"
            ]
          }
        ]
      }
    }
  ]
}

            "const": "configure_dependency"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "signed_bundle_validated"
          },
          "state": {
            "enum": [
              "blocked",
              "unavailable"
            ]
          }
        },
        "required": [
          "key",
          "state"
        ]
      },
      "then": {
        "properties": {
          "recovery_action": {
            "const": "import_signed_bundle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "no_egress_validated"
          },
          "state": {
            "enum": [
              "blocked",
              "unavailable"
            ]
          }
        },
        "required": [
          "key",
          "state"
        ]
      },
      "then": {
        "properties": {
          "recovery_action": {
            "const": "restore_no_egress"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "policy_validated"
          },
          "state": {
            "enum": [
              "blocked",
              "unavailable"
            ]
          }
        },
        "required": [
          "key",
          "state"
        ]
      },
      "then": {
        "properties": {
          "recovery_action": {
            "const": "correct_policy"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "key": {
            "const": "dry_run_validated"
          },
          "state": {
            "enum": [
              "blocked",
              "unavailable"
            ]
          }
        },
        "required": [
          "key",
          "state"
        ]
      },
      "then": {
        "properties": {
          "recovery_action": {
            "const": "run_dry_run"
          }
        }
      }
    }
  ]
}

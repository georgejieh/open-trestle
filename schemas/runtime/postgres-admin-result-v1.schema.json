{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-trestle:schema:runtime:postgres-admin-result:v1",
  "title": "Open Trestle PostgreSQL administration result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "status",
    "operation"
  ],
  "properties": {
    "contract": {
      "const": "open-trestle/postgres-admin-result"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "valid"
    },
    "operation": {
      "enum": [
        "identity",
        "migrate",
        "verify",
        "initialize"
      ]
    },
    "database_authority_identity": {
      "$ref": "urn:open-trestle:schema:setup:plan:v1#/$defs/digest"
    },
    "publication_authority_receipt_identity": {
      "$ref": "urn:open-trestle:schema:setup:plan:v1#/$defs/digest"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "identity"
        }
      },
      "required": [
        "operation",
        "database_authority_identity"
      ],
      "not": {
        "required": [
          "publication_authority_receipt_identity"
        ]
      }
    },
    {
      "properties": {
        "operation": {
          "const": "migrate"
        }
      },
      "required": [
        "operation"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "database_authority_identity"
            ]
          },
          {
            "required": [
              "publication_authority_receipt_identity"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "operation": {
          "const": "verify"
        }
      },
      "required": [
        "operation"
      ],
      "not": {
        "required": [
          "database_authority_identity"
        ]
      }
    },
    {
      "properties": {
        "operation": {
          "const": "initialize"
        }
      },
      "required": [
        "operation",
        "publication_authority_receipt_identity"
      ],
      "not": {
        "required": [
          "database_authority_identity"
        ]
      }
    }
  ]
}

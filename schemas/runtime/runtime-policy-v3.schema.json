                  },
                  {
                    "not": {
                      "pattern": "^https://[0-9.]+(?::|/|$)"
                    }
                  }
                ]
              },
              {
                "pattern": "^https://(?:(?:0|[1-9]\\d?|1\\d{2}|2[0-4]\\d|25[0-5])\\.){3}(?:0|[1-9]\\d?|1\\d{2}|2[0-4]\\d|25[0-5])(?::(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^?#%\\\\\\s]*)?$"
              },
              {
                "allOf": [
                  {
                    "pattern": "^https://\\[(?:(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0:0(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|::|::[1-9a-f][0-9a-f]{0,3}|::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3})|::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|::(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){3}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|::(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|[1-9a-f][0-9a-f]{0,3}::|[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}|[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3})|[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|[1-9a-f][0-9a-f]{0,3}::(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){3}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|[1-9a-f][0-9a-f]{0,3}::(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::|(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}|(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3})|(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){1}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::|(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3})|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){1}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*\\])[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){3}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){1}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}:(?:0|[1-9a-f][0-9a-f]{0,3})|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){2}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){1}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::[1-9a-f][0-9a-f]{0,3}|(?!(?:(?:0|[1-9a-f][0-9a-f]{0,3}):)*0(?::0){1}(?::(?:0|[1-9a-f][0-9a-f]{0,3}))*::)(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3}):[1-9a-f][0-9a-f]{0,3}::)\\](?::(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^?#%\\\\\\s]*)?$"
                  },
                  {
                    "not": {
                      "pattern": "^https://\\[::ffff:(?:0|[1-9a-f][0-9a-f]{0,3}):(?:0|[1-9a-f][0-9a-f]{0,3})\\]"
                    }
                  }
                ]
              },
              {
                "pattern": "^http://(?:(?:127\\.(?:0|[1-9]\\d?|1\\d{2}|2[0-4]\\d|25[0-5])\\.(?:0|[1-9]\\d?|1\\d{2}|2[0-4]\\d|25[0-5])\\.(?:0|[1-9]\\d?|1\\d{2}|2[0-4]\\d|25[0-5]))|(?:\\[::1\\]))(?::(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^?#%\\\\\\s]*)?$"
              }
            ],

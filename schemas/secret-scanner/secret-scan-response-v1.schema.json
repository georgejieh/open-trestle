{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-trestle:schema:secret-scanner:response:v1",
  "title": "Open Trestle Secret Scan Response v1",
  "description": "Closed content-free response contract for the pinned Betterleaks v1.8.1 secret scanner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "scanner",
    "scanner_version",
    "scanner_commit",
    "ruleset_identity",
    "build_profile",
    "matches"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "input_rejected",
        "scan_failed",
        "resource_exhausted"
      ]
    },
    "scanner": {
      "type": "string",
      "const": "betterleaks",
      "description": "The exact scanner implementation used for protocol v1."
    },
    "scanner_version": {
      "type": "string",
      "const": "v1.8.1",
      "description": "The pinned Betterleaks release version."
    },
    "scanner_commit": {
      "type": "string",
      "const": "5eab48332cc48565864514e3bc6de89df091a7c4",
      "description": "The pinned Betterleaks source commit."
    },
    "ruleset_identity": {
      "type": "string",
      "const": "27ded783c81940d13c22cc46556a3f8184baf397bff08a69fcfae87991925f42",
      "description": "SHA-256 of the embedded Betterleaks v1.8.1 default config containing 417 rules."
    },
    "build_profile": {
      "type": "string",
      "const": "public_detect_run_re2_purego_go1.26.8_linux_amd64_v1",
      "description": "The reviewed public detect.Run, RE2, pure-Go Linux amd64 build profile."
    },
    "matches": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8192,
      "items": {
        "$ref": "#/$defs/match"
      }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ordinal",
        "rule_id",
        "start_byte",
        "end_byte_exclusive",
        "occurrence_id"
      ],
      "properties": {
        "source_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262143
        },
        "end_byte_exclusive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "occurrence_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "A content-independent identifier derived from scanner identity, rule ID, source ordinal, and span."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "complete"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "matches": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

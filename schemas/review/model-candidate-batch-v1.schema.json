{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-trestle:schema:review:model-candidate-batch:v1",
  "title": "Open Trestle Model Candidate Batch v1",
  "description": "Canonical syntax for untrusted model-proposed review candidates. Validation does not create a finding or prove factual support, range validity, evidence authority, or final severity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates"
  ],
  "$defs": {
    "reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]",
      "description": "Opaque host-issued reference copied from the model input allow-list.",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "source_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "start_line",
        "end_line"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/reference_id"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "description": "A 1-based inclusive proposed range. Trusted admission must resolve the source and verify ordering and bounds."
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "claim",
        "severity_hint",
        "source_range",
        "evidence_ids"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "[^\\u0009\\u000a\\u000b\\u000c\\u000d\\u0020]",
          "description": "Nonblank untrusted plain text without carriage returns or line feeds.",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "[^\\u0009\\u000a\\u000b\\u000c\\u000d\\u0020]",
          "description": "Nonblank untrusted text. ASCII whitespace alone is not content."
        },
        "severity_hint": {
          "description": "Advisory severity only. A verifier assigns any final severity.",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "source_range": {
          "$ref": "#/$defs/source_range"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference_id"
          },
          "description": "Host-issued evidence references. Trusted admission must resolve every value against the request allow-list."
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "candidates": {
      "description": "Untrusted candidate proposals. An empty array is a valid no-candidate response.",
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-trestle:schema:review:model-verification-batch:v1",
  "title": "Open Trestle Model Verification Batch v1",
  "description": "Canonical syntax for untrusted independent-verifier verdicts. Admission binds every verdict to a host-issued candidate and exact evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdicts"
  ],
  "$defs": {
    "reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "candidate_id": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "outcome",
        "severity",
        "rationale",
        "evidence_ids"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "verified",
            "rejected",
            "inconclusive"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "[^\\u0009\\u000a\\u000b\\u000c\\u000d\\u0020]"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference_id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "evidence_ids": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "severity": {
                "const": "none"
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "verdicts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/verdict"
      }
    }
  }
}
